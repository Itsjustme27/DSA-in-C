#include <stdio.h>

void enqueue(int queue[], int max, int front, int rear, int item);

int main() {
	int arr[5];
	printf("Enter elements: ");
	for(int i = 0; i < 5; i++) {
		scanf("%d", &arr[i]);
	}
	
	enqueue(arr, 5, -1, -1, 10);
	return 0;
}

void enqueue(int queue[], int max, int front, int rear, int item) {
	if(rear	+ 1 == max) {
		printf("overflow");
	} else {
		if(front == -1 && rear == -1) {
			front = 0;
			rear = 0;
		}else {
			rear = rear + 1;
		}
		queue[rear] = item;
	}
	for(int i = 0; i < 5; i++) {
		printf("%d", queue[i]);
	}
}
